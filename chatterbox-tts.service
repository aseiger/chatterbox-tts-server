[Unit]
Description=Chatterbox TTS server (FastAPI, 0.0.0.0:8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alex
WorkingDirectory=/home/alex/chatterbox
ExecStart=/home/alex/chatterbox/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=5
# Environment hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
